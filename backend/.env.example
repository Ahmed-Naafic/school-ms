# Copy this file to .env and fill in real values. Never commit .env.

# connect_timeout/pool_timeout (seconds): without these, Prisma has no
# timeout at all against a stalled connection — against a serverless/pooled
# provider (e.g. Neon) that can go idle, a stalled connection then hangs the
# request forever instead of failing fast and being retryable.
DATABASE_URL="postgresql://user:password@localhost:5433/school_management?connect_timeout=15&pool_timeout=15"

PORT=4000

# Signing secrets for access and refresh tokens. Use long, random values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# One-time platform bootstrap (Authentication-and-Authorization.md Business Rule #23).
# Used only by prisma/seed.js to create the first Super Admin account.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=

# How password-reset / initial-account-setup tokens are delivered. One of:
#   development — logs the raw token to the console. NEVER use in production.
#   email / sms — requires an approved provider integration (not built yet;
#                  selecting this mode throws until one is wired up).
#   disabled    — password recovery is rejected outright.
# Defaults to "disabled" if unset or invalid — a missing/misconfigured value
# must fail safe (recovery off), never fail dangerous (tokens logged).
# A real email/SMS provider is a hard prerequisite for using this feature in
# production; see Technology-Decisions.md and Security-Standards.md.
PASSWORD_RESET_DELIVERY_MODE=

# Used only by integration tests (src/shared/test-helpers.js) to log in as the
# seeded Super Admin. Keep this in sync with whatever that account's password
# actually is right now — it will have changed away from
# SUPER_ADMIN_BOOTSTRAP_PASSWORD after that account's first, mandatory
# credential change.
TEST_SUPER_ADMIN_PASSWORD=

# Local-only convenience for manually logging in as the seeded local "Test
# School" SCHOOL_ADMIN account during development (not read by any test
# helper or app code). Never commit real values here — set them in .env only.
TEST_SCHOOL_ADMIN_EMAIL=
TEST_SCHOOL_ADMIN_PASSWORD=