# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://user:password@localhost:5432/school_management"

PORT=4000

# Signing secrets for access and refresh tokens. Use long, random values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# One-time platform bootstrap (Authentication-and-Authorization.md Business Rule #23).
# Used only by prisma/seed.js to create the first Super Admin account.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
